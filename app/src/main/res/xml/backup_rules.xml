<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: back up only the page's saved data (watches, records, settings in WebView localStorage). -->
<full-backup-content>
    <include domain="root" path="app_webview/Default/Local Storage/" />
    <include domain="root" path="app_webview/Local Storage/" />
</full-backup-content>
