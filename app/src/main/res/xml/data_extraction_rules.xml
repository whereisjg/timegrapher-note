<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Google cloud backup and phone-to-phone transfer keep the page's saved data
     (watches, records, settings in WebView localStorage). Pro status is restored from Google Play, not from here. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <include domain="root" path="app_webview/Local Storage/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/Default/Local Storage/" />
        <include domain="root" path="app_webview/Local Storage/" />
    </device-transfer>
</data-extraction-rules>
